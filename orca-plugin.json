{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "github-trending",
  "name": "GitHub Trending",
  "version": "1.2.0",
  "description": "Discover trending GitHub repositories without leaving Orca. Filter by language and time, match your workspace, and save projects for later.",
  "author": {
    "name": "Eric Tai"
  },
  "repository": "https://github.com/cplog/trending-for-orca",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "pluginApi": 1,
  "main": "worker/main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "trending",
        "title": "GitHub Trending",
        "icon": "rocket",
        "entry": "panel/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "trending.toggle",
        "title": "GitHub Trending: Show or hide side panel",
        "action": "sidebar.right.toggle"
      },
      {
        "id": "trending.refresh",
        "title": "GitHub Trending: Refresh"
      }
    ],
    "statusBarItems": [
      {
        "id": "top",
        "icon": "rocket",
        "text": "Trending",
        "tooltip": "Top trending on GitHub today",
        "command": "trending.toggle"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    }
  ]
}
