{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "github-trending",
  "name": "GitHub Trending",
  "version": "1.4.1",
  "description": "Discover trending GitHub repositories without leaving Orca. Filter by language and time, save projects, or try one in a new workspace with an agent.",
  "author": {
    "name": "Eric Tai"
  },
  "repository": "https://github.com/cplog/trending-for-orca",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.259"
  },
  "pluginApi": 1,
  "main": "worker/main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "trending",
        "title": "GitHub Trending",
        "icon": "rocket",
        "entry": "panel/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "trending.toggle",
        "title": "GitHub Trending: Show or hide side panel",
        "action": "sidebar.right.toggle"
      },
      {
        "id": "trending.refresh",
        "title": "GitHub Trending: Refresh"
      }
    ],
    "statusBarItems": [
      {
        "id": "top",
        "icon": "rocket",
        "text": "Trending",
        "tooltip": "Top trending on GitHub today",
        "command": "trending.toggle"
      }
    ],
    "settings": [
      {
        "key": "agent",
        "title": "Agent",
        "description": "The agent that Try in a workspace starts.",
        "type": "string",
        "enum": [
          "claude",
          "codex",
          "gemini"
        ],
        "enumLabels": [
          "Claude Code",
          "Codex",
          "Gemini"
        ],
        "default": "claude"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:launch"
    },
    {
      "kind": "workspace:create"
    },
    {
      "kind": "settings:own"
    }
  ],
  "icon": "assets/icon.png",
  "cover": {
    "path": "assets/cover.png",
    "alt": "The GitHub Trending panel in Orca's dark theme, listing repositories with their language and stars gained this month."
  },
  "screenshots": [
    {
      "path": "assets/screenshot-list.png",
      "alt": "The GitHub Trending panel with period tabs, a language select, a filter box and a list of repositories.",
      "caption": "Trending repositories in the sidebar, drawn with Orca's own controls.",
      "theme": "dark"
    }
  ]
}
